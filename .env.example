# PDH Smart EMS Environment Configuration
NODE_ENV=development
PORT=5000

# Database (MySQL 8 / MariaDB 10.4+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pdh_smart_ems

# Authentication (seconds); production uses HTTPS Secure cookies
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_LIFETIME=43200
MAX_FAILED_LOGIN=5
LOCK_DURATION=900
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW=900
PASSWORD_MIN_LENGTH=12
# Set only for bootstrap/test seeding; never use shared default credentials
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# Telematics & Tracking Settings
NORMAL_SYNC_INTERVAL_SEC=300
EMERGENCY_SYNC_INTERVAL_SEC=45
GPS_STALE_THRESHOLD_SEC=120
GPS_LOST_THRESHOLD_SEC=300

# Map & Routing Adapter Defaults
DEFAULT_MAP_PROVIDER=openstreetmap
DEFAULT_ROUTING_PROVIDER=simple_estimate

# CORS
CORS_ORIGIN=http://localhost:5173
